# Copy this file to config/.env and fill in real values. config/.env is gitignored.
#
# Shared access token for mydiamonds.info assets (cert PDFs and direct mp4 downloads).
# Every media hyperlink in Aarin_Complied_Stones.xlsx carries this same `u=` query
# parameter; pasting that value here lets 02_download_media.py fetch videos directly.
#
# The ingest script (src/01_ingest_excel.py) does not strictly require the token --
# it only reads/parses the spreadsheet -- but it will log MEDIA_TOKEN status so you
# know whether the downstream download step is configured.
AARIN_MEDIA_TOKEN=
